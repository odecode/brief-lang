// cast_lanes.bv — native process/output lanes and the portable casting facade.
// 2026-10-21: portable bodies moved verbatim to cast_portable.bv. Importing
// this facade preserves the existing native API and each historical rationale.
// Browser targets import cast_portable directly; platform choices stay in stdlib.
import "std/cast_portable.bv";

// The print plugin lowers to the `Print#` intrinsic, which the backend
// dispatches to these defns; they provide the symbols with byte-identical
// behavior to the C originals (briev_rt.c 572-640). Output goes through
// write(2) — SYS_write=1 on
// x86_64 Linux — and exit_prog through SYS_exit_group=231.
// TODO(arch): 64/94 are the aarch64 numbers; the source language has no arch
// reflection yet (`.^` targets: Length/Ptr/Size/Bytes/Alignment/Type), so
// the x86_64 numbers stand until a target-const mechanism exists.
//
// Buffering note: C stdout to a pipe is fully buffered, flushed at exit; to
// a tty, line buffered. write(2) is unbuffered. The BYTES are identical in
// both orderings — only interactive partial-line timing differs.

// ── Buffered stdout (2026-09-11, fasta A/B; BUGS.md) ────────────────
// write(2) is unbuffered; the retired libc path buffered for free. A
// per-byte print in a loop (fasta) cost one SYSCALL per byte — 10M
// iterations, ~100x the C reference. The buffer is a fixed 64 KiB
// block + fill pointer (LIBRARY STATE — lets import since 158ae9ec);
// append is O(1) via Store#, flush at capacity, at exit_prog, and at the
// main tail (the backend calls stdout_flush when this lane is
// linked). stderr stays unbuffered. Pipe semantics match the C
// baseline (fully buffered); tty line-buffering is deferred.

// 2026-10-17 (plain storage, SPEC §8.1): the buffer is library PLUMBING —
// no contract references it, the machine never reasons about it. `plain`
// keeps it out of %State, so the print chain carries no state pointer and
// %State promotion in printing loops is never defeated (the
// buffered-stdout regression, docs/plans/2026-10-17-state-plain-storage-class.md).
plain let stdout_buf: Int = 0;
plain let stdout_fill: Int = 0;
const STDOUT_CAP: Int = 65536;

out defn stdout_flush() [true][term >= 0] -> Int {
    when stdout_fill > 0 {
        let n: Int = SysCall#(1, 1, stdout_buf, stdout_fill, 0, 0, 0);
        stdout_fill = 0;
        term n;
    };
    term 0;
};

out defn stdout_byte(b: Int) [true][term >= 0] -> Int {
    when stdout_buf == 0 {
        stdout_buf = Alloc#(STDOUT_CAP) as Int;
    };
    Store#(stdout_buf + stdout_fill, b, 1);
    stdout_fill = stdout_fill + 1;
    when stdout_fill == STDOUT_CAP {
        term stdout_flush();
    };
    term 0;
};

// write_all — write the whole payload of String s to fd. fd 1 goes
// through the stdout buffer (byte-appended, flushed at capacity); fd 2
// (stderr) stays direct and unbuffered.
defn write_all(fd: Int, s: String) [fd >= 0][term >= 0] -> Int {
    let addr: Int = (s as Data) as Int;
    let len: Int = Load#(addr, 8);
    when len <= 0 {
        term 0;
    };
    when fd == 1 {
        foreach i in 0..len {
            let r: Int = stdout_byte(Load#(addr + 8 + i, 1));
        };
        term len;
    };
    term SysCall#(1, fd, addr + 8, len, 0, 0, 0);
};

out defn print_str(s: String) [true][term >= 0] -> Int {
    // 2026-09-23 (term_guard_value exit-code parity): defns cannot be void,
    // so a side-effect-only print claims the neutral success value, 0 — not
    // the byte count (the old return made `endprogram Print#(x)` exit with the
    // string length). Matching the interpreter's Print# (intrinsics.rs) and
    // every sibling in this family.
    let _r: Int = write_all(1, s);
    term 0;
};

out defn print_str_raw(s: String) [true][term >= 0] -> Int {
    let _r: Int = write_all(1, s);
    term 0;
};

out defn eprint_str(s: String) [true][term >= 0] -> Int {
    // 2026-10-12: aligned to the family's neutral-0 convention — the
    // byte-count return was the one outlier in the print family.
    let _r: Int = write_all(2, s);
    term 0;
};

out defn print_int(n: Int) [true][term >= 0] -> Int {
    let _r: Int = write_all(1, int_to_str(n));
    term 0;
};

out defn print_bool(b: Int) [true][term >= 0] -> Int {
    let _r: Int = write_all(1, bool_to_str(b));
    term 0;
};

out defn print_float(f: Float) [true][term >= 0] -> Int {
    // C: printf("%.9g", (double)f) — float_format(f, 9) is byte-parity
    // (the float_cases corpus pins it). Return 0 like the C printf+0.
    let _r: Int = write_all(1, float_format(f, 9));
    term 0;
};

out defn put_char(c: Int) [c >= 0][term >= 0] -> Int {
    // C: c==10 → puts("") (writes '\n'), else putchar(c) — one raw byte
    // either way. Buffered: O(1) append, flushed at capacity/main tail.
    // Return 0 like the C putchar+0.
    let _r: Int = stdout_byte(c);
    term 0;
};

out defn exit_prog(code: Int) [true][term >= 0] -> Int {
    // Flush the stdout buffer before SYS_exit_group (231, x86_64) —
    // nothing runs after the process ends.
    let f: Int = stdout_flush();
    term SysCall#(231, code, 0, 0, 0, 0, 0);
};

// ── Watchdog clock + fail (Family I misc) ───────────────────────────────
// rt_now_ns — CLOCK_MONOTONIC ns via SYS_clock_gettime. The `within N ms`
// deadline compare calls this PER ITERATION in watchdogged loops.
// TODO(arch): 228 is the x86_64 SYS_clock_gettime (aarch64 uses 113); the
// language has no arch reflection yet — same documented gap as the print
// family's syscall numbers.
out defn rt_now_ns() [true][term >= 0] -> Int {
    let ts: Int = Alloc#(16) as Int;
    Store#(ts, 0, 8);
    Store#(ts + 8, 0, 8);
    SysCall#(228, 1, ts, 0, 0, 0, 0);
    let sec: Int = Load#(ts, 8);
    let ns: Int = Load#(ts + 8, 8);
    term sec * 1000000000 + ns;
};

// watchdog_fail — a required watchdog fired: message to stderr, exit(1).
// (The C printed via fprintf + libc exit; the write+exit_group pair is the
// Briev-native equivalent.)
out defn watchdog_fail() [true][term >= 0] -> Int {
    let _m: Int = write_all(2, "briev: required watchdog fired\n");
    SysCall#(231, 1, 0, 0, 0, 0, 0);
    term 0;
};

// ── Working directory + scheduler free (Family I) ───────────────────────
// rt_getcwd — SYS_getcwd(63) into an Alloc#(4096) buffer. Returns the
// C-STRING address: the GetCwd# call site strlen's it (the C ABI preserved
// so the site's null-check + dance is untouched). Failure → 0 (null).
out defn rt_getcwd() [true][term >= 0] -> Int {
    let buf: Int = Alloc#(4096) as Int;
    let r: Int = SysCall#(63, buf, 4096, 0, 0, 0, 0);
    when r < 0 {
        term 0;
    };
    term buf;
};

// rt_chdir — SYS_chdir(80).
out defn rt_chdir(p: Int) [p >= 0][term >= -1 && term <= 0] -> Int {
    term SysCall#(80, p, 0, 0, 0, 0, 0);
};

// rt_free — arena semantics: a no-op. Arena memory retires when the
// arena resets; the C incremented a calibration counter and libc-free()d —
// neither exists under the arena model. (rt_free_count had zero
// referencers and was deleted with the C.)
out defn rt_free(p: Int) [p >= 0][term >= 0] -> Int {
    term 0;
};

// wait_for_trigger — the idle-tick yield for unbounded async loops
// (was pause()). sched_yield(24) hands the CPU back; a proper wake-trigger
// wait (nanosleep/futex) is the wake-trigger follow-up.
out defn wait_for_trigger() [true][term >= 0] -> Int {
    SysCall#(24, 0, 0, 0, 0, 0, 0);
    term 0;
};

// ── Captured-environ getenv (Family F) ──────────────────────────────────
// The owned _start captures the environ pointer from the initial kernel
// stack into @__briev_environ; the backend emits C-ABI adapters
// (__getenv_int/__getenv_briev) that hand it to these impls. Entries are
// NUL-terminated "KEY=VALUE" strings; the KEY side is a Briev String
// ([len][bytes]) so the match needs no NUL termination.

// cstr_len — NUL-terminated string length (replaces the libc strlen the
// GetCwd# call site used — one of the last libc references).
out defn cstr_len(p: Int) [true][term >= 0] -> Int {
    when Load#(p, 1) == 0 {
        term 0;
    };
    term 1 + cstr_len(p + 1);
};

// env_key_match — does the C string at s begin with key's bytes + '='?
// i = bytes matched so far (recursion index over the KEY's klen bytes).
defn env_key_match(key: Int, klen: Int, s: Int, i: Int)
    [true][term == true || term == false] -> Bool {
    when i >= klen {
        when Load#(s + i, 1) == 61 {
            term true;
        };
        term false;
    };
    when Load#(key + 8 + i, 1) != Load#(s + i, 1) {
        term false;
    };
    term env_key_match(key, klen, s, i + 1);
};

// environ_find — the address of the VALUE string for key, or -1 (0 - 1).
// Entries live at environ + 8*i; a NULL entry ends the array.
defn environ_find(key: Int, klen: Int, environ: Int, i: Int)
    [true][term >= -1] -> Int {
    let entry: Int = Load#(environ + 8 * i, 8);
    when entry == 0 {
        term 0 - 1;
    };
    when env_key_match(key, klen, entry, 0) {
        term entry + klen + 1;
    };
    term environ_find(key, klen, environ, i + 1);
};

// briev_getenv_briev_impl — the VALUE as a fresh Briev String; no match →
// an empty String (the C returned NULL and callers null-checked).
out defn briev_getenv_briev_impl(key: Int, environ: Int)
    [true][term .^Length >= 0] -> String {
    let klen: Int = Load#(key, 8);
    let vp: Int = environ_find(key, klen, environ, 0);
    when vp < 0 {
        let empty: Int = Alloc#(9) as Int;
        Store#(empty, 0, 8);
        Store#(empty + 8, 0, 1);
        term (empty as Data) as String;
    };
    let vlen: Int = cstr_len(vp);
    let buf: Int = Alloc#(8 + vlen + 1) as Int;
    Store#(buf, vlen, 8);
    Copy#(buf + 8, vp, vlen);
    Store#(buf + 8 + vlen, 0, 1);
    term (buf as Data) as String;
};

// env_int_digits — strtol-style digit run (sign folded by the caller).
defn env_int_digits(p: Int, acc: Int, sign: Int)
    [true][term == 0 || term != 0] -> Int {
    let b: Int = Load#(p, 1);
    when b < 48 || b > 57 {
        term acc;
    };
    term env_int_digits(p + 1, acc * 10 + (b - 48) * sign, sign);
};

// briev_getenv_int_impl — the VALUE parsed as an Int (strtol-style: no
// digits → 0); no match → 0. The get_env_int! const path folds at compile
// time — this is the RUNTIME getenv the bindings ghost never provided.
out defn briev_getenv_int_impl(key: Int, environ: Int)
    [true][term == 0 || term != 0] -> Int {
    let klen: Int = Load#(key, 8);
    let vp: Int = environ_find(key, klen, environ, 0);
    when vp < 0 {
        term 0;
    };
    let b: Int = Load#(vp, 1);
    when b == 45 {
        term env_int_digits(vp + 1, 0, 0 - 1);
    };
    when b == 43 {
        term env_int_digits(vp + 1, 0, 1);
    };
    term env_int_digits(vp, 0, 1);
};

// ── Task/event machine (Family H, 2026-09-10) ───────────────────────────
// The compiled async scheduler over the captured heads: @__briev_sched
// points at a [head, tail, current-task] block (task records, linked);
// @__briev_events at a [head, tail] block (event records, linked). Both
// bootstrapped lazily (first use Alloc#s the block). Task record (16
// slots): [next, status, cursor, nseg, argc, result, segments, args(8)].
// Statuses: 0 READY, 1 YIELDED, 2 DONE, 3 CANCELLED, 4 WAITING. Segment
// ABI (backend): i64 @seg(ptr state, ptr argv, ptr out) - status returned,
// value stored through the out cell - dispatchable via TaskCall#.
// Deterministic round-robin preserved exactly: one segment per runnable
// task per pass, list order = spawn order (tail append), spawn-id-order
// walk, deadlock posture returns the handle.

// sched_tail_block - bootstrap the [head, tail, current] block; returns it.
out defn sched_tail_block(sched: Int) [sched >= 0][term >= 0] -> Int {
    let blk: Int = Load#(sched, 8);
    when blk != 0 {
        term blk;
    };
    let nb: Int = Alloc#(24) as Int;
    Store#(nb, 0, 8);
    Store#(nb + 8, 0, 8);
    Store#(nb + 16, 0 - 1, 8);
    Store#(sched, nb, 8);
    term nb;
};

// briev_task_spawn_impl - append a task record at the tail; the handle is
// the record address (opaque to the backend).
out defn briev_task_spawn_impl(sched: Int, table: Int, nseg: Int, nargs: Int, argv: Int)
    [sched >= 0 && table >= 0 && nseg >= 1 && nargs >= 0][term >= 0] -> Int {
    let blk: Int = sched_tail_block(sched);
    let rec: Int = Alloc#(128) as Int;
    Store#(rec + 8, 0, 8);
    Store#(rec + 16, 0, 8);
    Store#(rec + 24, nseg, 8);
    Store#(rec + 32, nargs, 8);
    Store#(rec + 40, 0, 8);
    Store#(rec + 48, table, 8);
    term spawn_copy_args(rec, argv, nargs, 0, blk);
};

// spawn_copy_args - copy the argv block into the record, then link at tail.
defn spawn_copy_args(rec: Int, argv: Int, nargs: Int, i: Int, blk: Int)
    [true][term >= 0] -> Int {
    when i < nargs {
        Store#(rec + 56 + 8 * i, Load#(argv + 8 * i, 8), 8);
        term spawn_copy_args(rec, argv, nargs, i + 1, blk);
    };
    let head: Int = Load#(blk, 8);
    Store#(rec, head, 8);
    Store#(blk, rec, 8);
    when head == 0 {
        Store#(blk + 8, rec, 8);
    };
    term rec;
};

// task_status - the record's status field.
defn task_status(rec: Int) [true][term >= 0 && term <= 4] -> Int {
    term Load#(rec + 8, 8);
};

// task_done - DONE status check (the await termination test).
defn task_done(target: Int) [true][term == true || term == false] -> Bool {
    when target == 0 {
        term false;
    };
    term task_status(target) == 2;
};

// task_result - the stored completion value.
defn task_result(rec: Int) [true][term >= 0] -> Int {
    term Load#(rec + 40, 8);
};

// briev_await_impl - the deterministic round-robin: passes until the
// target is DONE; an empty runnable pool returns the handle (deadlock).
out defn briev_await_impl(sched: Int, target: Int)
    [sched >= 0 && target >= 0][term >= 0] -> Int {
    let blk: Int = sched_tail_block(sched);
    term await_passes(blk, target);
};

// await_passes - one scheduler pass per recursion level.
defn await_passes(blk: Int, target: Int)
    [true][term >= 0] -> Int {
    when task_done(target) {
        term task_result(target);
    };
    let ran: Int = await_one_pass(blk, Load#(blk, 8), 0);
    when ran == 0 {
        // Deadlock posture: empty runnable pool, target unfinished - return
        // the handle instead of hanging (cooperative, no preemption).
        term target;
    };
    term await_passes(blk, target);
};

// await_one_pass - one segment per runnable task, list order. blk is the
// scheduler block: [16] holds the CURRENT task record while its segment
// runs (the event-read blocked path registers it as a waiter).
defn await_one_pass(blk: Int, cur: Int, ran: Int)
    [true][term >= 0] -> Int {
    when cur == 0 {
        term ran;
    };
    let nxt: Int = Load#(cur, 8);
    let st: Int = task_status(cur);
    when st != 0 && st != 1 {
        term await_one_pass(blk, nxt, ran);
    };
    let cursor: Int = Load#(cur + 16, 8);
    let nseg: Int = Load#(cur + 24, 8);
    when cursor >= nseg {
        term await_one_pass(blk, nxt, ran);
    };
    let out_cell: Int = Alloc#(16) as Int;
    let seg_table: Int = Load#(cur + 48, 8);
    let seg_ptr: Int = Load#(seg_table + 8 * cursor, 8);
    // CURRENT task = this record while its segment runs (the event-read
    // blocked path reads [blk + 16] to register the waiter).
    Store#(blk + 16, cur, 8);
    let status: Int = TaskCall#(seg_ptr, cur + 56, out_cell);
    Store#(blk + 16, 0 - 1, 8);
    when status == 1 {
        Store#(cur + 8, 2, 8);
        Store#(cur + 40, Load#(out_cell, 8), 8);
        term await_one_pass(blk, nxt, ran + 1);
    };
    when status == 2 {
        // BLOCKED on an unready port: cursor does NOT advance - the read
        // heads its segment, so the post-wake re-run starts AT the read.
        Store#(cur + 8, 4, 8);
        term await_one_pass(blk, nxt, ran + 1);
    };
    Store#(cur + 16, cursor + 1, 8);
    Store#(cur + 8, 1, 8);
    term await_one_pass(blk, nxt, ran + 1);
};

// briev_task_cancel_impl - mark CANCELLED unless already DONE/CANCELLED.
out defn briev_task_cancel_impl(sched: Int, target: Int)
    [sched >= 0 && target >= 0][term >= 0] -> Int {
    let st: Int = task_status(target);
    when st != 2 && st != 3 {
        Store#(target + 8, 3, 8);
    };
    term 0;
};

// ── Event ports ─────────────────────────────────────────────────────────

// events_tail_block - bootstrap the [head, tail] block; returns it.
out defn events_tail_block(events: Int) [events >= 0][term >= 0] -> Int {
    let blk: Int = Load#(events, 8);
    when blk != 0 {
        term blk;
    };
    let nb: Int = Alloc#(16) as Int;
    Store#(nb, 0, 8);
    Store#(nb + 8, 0, 8);
    Store#(events, nb, 8);
    term nb;
};

// briev_event_alloc_impl - append a fresh event record; handle = address.
out defn briev_event_alloc_impl(events: Int)
    [events >= 0][term >= 0] -> Int {
    let blk: Int = events_tail_block(events);
    let rec: Int = Alloc#(104) as Int;
    Store#(rec + 8, 0, 8);
    Store#(rec + 16, 0, 8);
    Store#(rec + 24, 0, 8);
    let head: Int = Load#(blk, 8);
    Store#(rec, head, 8);
    Store#(blk, rec, 8);
    when head == 0 {
        Store#(blk + 8, rec, 8);
    };
    term rec;
};

// briev_event_ready_impl - nonzero when the port holds a payload.
out defn briev_event_ready_impl(events: Int, slot: Int)
    [events >= 0 && slot >= 0][term == true || term == false] -> Bool {
    when slot == 0 {
        term false;
    };
    term Load#(slot + 8, 8) != 0;
};

// briev_event_read_impl - 1 ready (payload stored to *out), 0 blocked
// (waiter registered), 2 strict-gate violation, -1 bad slot.
out defn briev_event_read_impl(events: Int, sched: Int, slot: Int, out_cell: Int)
    [events >= 0 && sched >= 0 && slot >= 0 && out_cell >= 0]
    [term >= -1 && term <= 2] -> Int {
    when slot == 0 {
        term 0 - 1;
    };
    when Load#(slot + 8, 8) != 0 {
        Store#(out_cell, Load#(slot + 16, 8), 8);
        term 1;
    };
    // Unready INSIDE a task: register as waiter, mark WAITING.
    let blk: Int = sched_tail_block(sched);
    let tid: Int = Load#(blk + 16, 8);
    when tid == 0 - 1 {
        term 2;
    };
    let nw: Int = Load#(slot + 24, 8);
    when nw < 8 {
        Store#(slot + 32 + 8 * nw, tid, 8);
        Store#(slot + 24, nw + 1, 8);
    };
    when task_status(tid) == 0 || task_status(tid) == 1 {
        Store#(tid + 8, 4, 8);
    };
    term 0;
};

// fire_drain - wake waiter i: WAITING tasks become schedulable again.
defn fire_drain(slot: Int, i: Int)
    [slot >= 0 && i >= 0][term >= 0] -> Int {
    when i >= Load#(slot + 24, 8) {
        term 0;
    };
    let tid: Int = Load#(slot + 32 + 8 * i, 8);
    when task_status(tid) == 4 {
        Store#(tid + 8, 0, 8);
    };
    term fire_drain(slot, i + 1);
};

// briev_event_fire_impl - store the payload, wake the waiters.
out defn briev_event_fire_impl(events: Int, slot: Int, payload: Int)
    [events >= 0 && slot >= 0][term >= 0] -> Int {
    when slot == 0 {
        term 0;
    };
    Store#(slot + 8, 1, 8);
    Store#(slot + 16, payload, 8);
    term fire_drain(slot, 0);
};

// event_strict_trap - a read of an unready port outside a task:
// message to stderr, exit(1).
out defn event_strict_trap() [true][term >= 0] -> Int {
    let _m: Int = write_all(2, "briev: read of an unready event port outside a task - gate the read with .^Ready\n");
    SysCall#(231, 1, 0, 0, 0, 0, 0);
    term 0;
};
