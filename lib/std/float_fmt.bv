// 2026-10-21: the 18-digit accumulator is physically 64-bit on every
// target. Fixed Int64 declarations preserve its headroom on wasm32; flexible
// Int silently overflowed the algorithm. Large constants are assembled from
// representable terms before arithmetic, so target-sized literals cannot wrap.
// float_fmt.bv - pure-Briev %.9g / %g float formatting (plan 6.2 spike).
//
// 2026-09-09: float_to_str (the cast lane, %g) and print_float (%.9g) must
// reproduce C printf byte-for-byte WITHOUT briev_rt.c. This implements exact
// leading-digit extraction for float32 (24-bit mantissa x 2^E, E in
// [-149, 104]) using only i64 arithmetic:
//
//   value = M x 2^E
//     E >= 0 (integer): shift-and-scale - acc x2 per bit, /10 when acc >=
//       10^18 (drops the low digit only; the leading 18 digits stay exact).
//     E < 0 (fraction): value = m / 2^b - long division with an 18-digit
//       headroom window.
//   digits 1-10 are EXACT; truncation only ever touches digit ~17+.
//
// Normalization to [1, 10): value<1 -> x10 (accx5, b-1); value>=10 -> /10
// (acc/10, k+1). Each digit = floor(acc/2^b); the next digit uses the
// remainder x10. Rounding (round-half-even) lives in the %g assembly, which
// also selects fixed vs exponential style - not here.
//
// Operator notes: `^` is XOR in Briev - never used as power. Contracts are
// [pre][post] - exactly two brackets; merge conditions with &&.

// float_bits - the IEEE-754 float32 bit pattern via the Data protocol
// bitcast (float -> i32 -> zext i64; the chain loop emits it - emit_expr.rs).
defn float_bits(f: Float) [true][term >= (0 as Int64)] -> Int64 {
    term (f as Data) as Int64;
};

// digit_char - a single decimal digit 0-9 to its character string.
defn digit_char(d: Int64) [d >= (0 as Int64) && d <= (9 as Int64)][(term .^Length as Int64) == (1 as Int64)] -> String {
    when d == (0 as Int64) { term "0"; };
    when d == (1 as Int64) { term "1"; };
    when d == (2 as Int64) { term "2"; };
    when d == (3 as Int64) { term "3"; };
    when d == (4 as Int64) { term "4"; };
    when d == (5 as Int64) { term "5"; };
    when d == (6 as Int64) { term "6"; };
    when d == (7 as Int64) { term "7"; };
    when d == (8 as Int64) { term "8"; };
    term "9";
};

// pow2 - 2^n for n in [0, 60] (2^60 = 1.15e18 <= i64 max).
defn pow2(n: Int64) [n >= (0 as Int64) && n <= (60 as Int64)][term >= (1 as Int64)] -> Int64 {
    when n == (0 as Int64) { term (1 as Int64); };
    term pow2(n - (1 as Int64)) * (2 as Int64);
};

// trunc - divide acc by 10 until below 1000000000000000000 (drops low digits only; keeps
// >= 18 significant digits - leading 9 + rounding digit survive).
defn trunc(acc: Int64) [true][term >= (0 as Int64)] -> Int64 {
    when acc < (((1000000000 as Int64) as Int64) * ((1000000000 as Int64) as Int64)) {
        term acc;
    };
    term trunc(acc / (10 as Int64));
};

// ---- Integer path (E >= 0): value = m x 2^e -----------------------------
// Shift-and-scale: acc x2 per bit; when acc >= 1000000000000000000, /10 and k++.
// acc's leading digits are exact; only the low digit is dropped per /10.
// Returns (acc, k) with value ~= acc x 10^k, acc < 1000000000000000000 (<= 18 digits).
defn sscale(acc: Int64, e: Int64, k: Int64)
    [acc >= (1 as Int64) && e >= (0 as Int64) && e <= (104 as Int64) && k >= -(30 as Int64) && k <= (40 as Int64)][term >= (0 as Int64)]
    -> (Int64, Int64)
{
    when e == (0 as Int64) {
        term (acc, k);
    };
    let a2: Int64 = acc * (2 as Int64);
    when a2 < (((1000000000 as Int64) as Int64) * ((1000000000 as Int64) as Int64)) {
        term sscale(a2, e - (1 as Int64), k);
    };
    term sscale(trunc(a2), e - (1 as Int64), k + (1 as Int64));
};

// ---- Fraction path (E < 0): value = m / 2^b ----------------------------
// pow2b - 2^b for b in [0, 60] (fraction comparisons; b > 60 handled by the
// value < 1 guard BEFORE calling this).
defn pow2b(b: Int64) [b >= (0 as Int64) && b <= (60 as Int64)][term >= (1 as Int64)] -> Int64 {
    when b == (0 as Int64) { term (1 as Int64); };
    term pow2b(b - (1 as Int64)) * (2 as Int64);
};

// frac_all_digits - the leading `count` digits of value = m / 2^b (b >= 1)
// as an integer. EXACT: no lossy /10 normalization. value < 1 is brought up
// by x10 (mx5, b-1, truncated at the 18-digit headroom); value >= 1 splits
// into the EXACT integer part (m >> b) whose digits come first, then the
// fraction continues by long division.
defn frac_all_digits(m: Int64, b: Int64, count: Int64)
    [m >= (0 as Int64) && m < (1 as Int64) << (24 as Int64) && b >= (1 as Int64) && b <= (149 as Int64) && count >= (1 as Int64) && count <= (10 as Int64)]
    [term >= (0 as Int64) && term < (((1000000000 as Int64) as Int64) * ((10 as Int64) as Int64))]
    -> Int64
{
    when count == (0 as Int64) {
        term (0 as Int64);
    };
    when m == (0 as Int64) {
        // The value is exactly zero — all digits are 0.
        term (0 as Int64);
    };
    when b > (60 as Int64) {
        // value < 1 (m < 2^24 < 2^60): x10 = mx5 with b-1; trunc keeps the
        // 18-digit headroom. Only the FIRST digit needs this — the digit loop
        // below never sees value < 1 in the wrong place.
        term frac_all_digits(trunc(m * (5 as Int64)), b - (1 as Int64), count);
    };
    when b >= (0 as Int64) && m < pow2b(b) {
        // value < 1, b in [0,60]: x10 (first-digit normalization).
        term frac_all_digits(trunc(m * (5 as Int64)), b - (1 as Int64), count);
    };
    // value >= 1: run the pure digit loop from here.
    term frac_digit_loop(m, b, count);
};

// frac_digit_loop - extract `count` digits of value = m / 2^b (value >= 1).
// Each step emits floor(m/2^b) as the digit and continues with the fraction
// x10 (frac x5, b-1). A sub-10 digit (the usual continuation case) is a
// single 0-9 digit; a >= 10 integer part (only the first step) emits all its
// digits first.
defn frac_digit_loop(m: Int64, b: Int64, count: Int64)
    [m > (0 as Int64) && b >= (0 as Int64) && b <= (60 as Int64) && count >= (1 as Int64) && count <= (10 as Int64)]
    [term >= (0 as Int64) && term < (((1000000000 as Int64) as Int64) * ((10 as Int64) as Int64))]
    -> Int64
{
    when count == (0 as Int64) {
        term (0 as Int64);
    };
    when m == (0 as Int64) {
        term (0 as Int64);
    };
    when b < (0 as Int64) {
        // value = m x 2^|b| — an exact integer (small m from rem x5).
        let v: Int64 = m << ((0 as Int64) - b);
        let nd: Int64 = int_digit_count(v);
        when nd >= count {
            term v / pow10(nd - count);
        };
        term v * pow10(count - nd);
    };
    let digit: Int64 = m >> b;
    let frac: Int64 = m % pow2b(b);
    when digit >= (10 as Int64) {
        // Multi-digit integer part (only possible on the first step): emit
        // all of digit's digits, then continue from the fraction.
        let nd: Int64 = int_digit_count(digit);
        when nd >= count {
            term digit / pow10(nd - count);
        };
        term digit * pow10(count - nd) + frac_digit_loop(frac * (5 as Int64), b - (1 as Int64), count - nd);
    };
    // Single 0-9 digit, then continue.
    term digit * pow10(count - (1 as Int64)) + frac_digit_loop(frac * (5 as Int64), b - (1 as Int64), count - (1 as Int64));
};

// frac_exp - the leading-digit decimal exponent k of m / 2^b (b >= 1).
defn frac_exp(m: Int64, b: Int64)
    [m >= (0 as Int64) && m < (1 as Int64) << (24 as Int64) && b >= (1 as Int64) && b <= (149 as Int64)][term >= -(45 as Int64) && term <= (40 as Int64)]
    -> Int64
{
    when b > (60 as Int64) || m < pow2b(b) {
        term frac_exp(trunc(m * (5 as Int64)), b - (1 as Int64)) - (1 as Int64);
    };
    term int_digit_count(m >> b) - (1 as Int64);
};

// float_rounded - the rounded leading `precision` digits of M x 2^E as an
// integer, plus the leading-digit exponent k.
defn float_rounded(m: Int64, e: Int64, precision: Int64)
    [m > (0 as Int64) && m < (1 as Int64) << (24 as Int64) && e >= -(149 as Int64) && e <= (104 as Int64) && precision >= (1 as Int64) && precision <= (9 as Int64)]
    [term >= (0 as Int64)]
    -> (Int64, Int64)
{
    when e >= (0 as Int64) {
        let (acc, kk): (Int64, Int64) = sscale(m, e, (0 as Int64));
        let nd: Int64 = int_digit_count(acc);
        let all: Int64 = int_leading_int(acc, nd, kk, precision + (1 as Int64));
        term round_all(all, precision, nd + kk - (1 as Int64));
    };
    let all: Int64 = frac_all_digits(m, (0 as Int64) - e, precision + (1 as Int64));
    let kk: Int64 = frac_exp(m, (0 as Int64) - e);
    term round_all(all, precision, kk);
};

// ---- Integer digits from the scaled acc --------------------------------
// int_digit_count - decimal digit count of acc (acc >= 1, < 1000000000000000000).
defn int_digit_count(acc: Int64) [acc >= (1 as Int64) && acc < (((1000000000 as Int64) as Int64) * ((1000000000 as Int64) as Int64))][term >= (1 as Int64) && term <= (19 as Int64)] -> Int64 {
    when acc < (10 as Int64) { term (1 as Int64); };
    when acc < (100 as Int64) { term (2 as Int64); };
    when acc < (1000 as Int64) { term (3 as Int64); };
    when acc < (10000 as Int64) { term (4 as Int64); };
    when acc < (100000 as Int64) { term (5 as Int64); };
    when acc < (1000000 as Int64) { term (6 as Int64); };
    when acc < (10000000 as Int64) { term (7 as Int64); };
    when acc < (100000000 as Int64) { term (8 as Int64); };
    when acc < (1000000000 as Int64) { term (9 as Int64); };
    when acc < (((1000000000 as Int64) as Int64) * ((10 as Int64) as Int64)) { term (10 as Int64); };
    when acc < (((1000000000 as Int64) as Int64) * ((100 as Int64) as Int64)) { term (11 as Int64); };
    when acc < (((1000000000 as Int64) as Int64) * ((1000 as Int64) as Int64)) { term (12 as Int64); };
    when acc < (((1000000000 as Int64) as Int64) * ((10000 as Int64) as Int64)) { term (13 as Int64); };
    when acc < (((1000000000 as Int64) as Int64) * ((100000 as Int64) as Int64)) { term (14 as Int64); };
    when acc < (((1000000000 as Int64) as Int64) * ((1000000 as Int64) as Int64)) { term (15 as Int64); };
    when acc < (((1000000000 as Int64) as Int64) * ((10000000 as Int64) as Int64)) { term (16 as Int64); };
    when acc < (((1000000000 as Int64) as Int64) * ((100000000 as Int64) as Int64)) { term (17 as Int64); };
    when acc < (((1000000000 as Int64) as Int64) * ((1000000000 as Int64) as Int64)) { term (18 as Int64); };
    term (19 as Int64);
};

// digits_of_int - the full decimal digits of acc (acc >= 0, < 1000000000000000000).
defn digits_of_int(acc: Int64) [acc >= (0 as Int64) && acc < (((1000000000 as Int64) as Int64) * ((1000000000 as Int64) as Int64))][(term .^Length as Int64) >= (1 as Int64)] -> String {
    when acc < (10 as Int64) {
        term digit_char(acc);
    };
    term digits_of_int(acc / (10 as Int64)) + digit_char(acc % (10 as Int64));
};

// zeros - a string of n zeros (n in [0, 20]).
defn zeros(n: Int64) [n >= (0 as Int64) && n <= (20 as Int64)][(term .^Length as Int64) == n] -> String {
    when n == (0 as Int64) { term ""; };
    term "0" + zeros(n - (1 as Int64));
};

// pow10 - 10^n for n in [0, 18].
defn pow10(n: Int64) [n >= (0 as Int64) && n <= (18 as Int64)][term >= (1 as Int64)] -> Int64 {
    when n == (0 as Int64) { term (1 as Int64); };
    term pow10(n - (1 as Int64)) * (10 as Int64);
};

// int_leading - the leading `want` digits of the integer value ~= acc x 10^k
// (acc has nd digits, total significant positions = nd + k). Returns the
// digit string (length `want`), padded with trailing zeros if shorter.
defn int_leading(acc: Int64, nd: Int64, k: Int64, want: Int64)
    [acc >= (1 as Int64) && nd >= (1 as Int64) && nd <= (19 as Int64) && k >= -(30 as Int64) && k <= (40 as Int64) && want >= (1 as Int64) && want <= (20 as Int64)]
    [(term .^Length as Int64) == want]
    -> String
{
    let total: Int64 = nd + k;
    when total <= want {
        term digits_of_int(acc) + zeros(want - total);
    };
    term digits_of_int(acc / pow10(total - want));
};

// ---- %g assembly: rounding, style, sign ---------------------------------
// int_leading_int - the leading `want` digits of acc x 10^k as an integer.
defn int_leading_int(acc: Int64, nd: Int64, k: Int64, want: Int64)
    [acc >= (1 as Int64) && nd >= (1 as Int64) && nd <= (19 as Int64) && k >= -(30 as Int64) && k <= (40 as Int64) && want >= (1 as Int64) && want <= (10 as Int64)]
    [term >= (0 as Int64) && term < (((1000000000 as Int64) as Int64) * ((10 as Int64) as Int64))]
    -> Int64
{
    let total: Int64 = nd + k;
    when total <= want {
        term acc * pow10(want - total);
    };
    term acc / pow10(total - want);
};

// round_all - round `all` (precision+1 digits as an int) to `precision`
// digits, returning (rounded, k). Extra digit >= 5 rounds up; carry makes the
// rounded int 10^precision and bumps k. Round-half-UP approximation (C printf
// is round-half-even; exact ties are rare for float32 — refine if one ever
// appears in the corpus).
defn round_all(all: Int64, precision: Int64, k: Int64)
    [all >= (0 as Int64) && all < (((1000000000 as Int64) as Int64) * ((10 as Int64) as Int64)) && precision >= (1 as Int64) && precision <= (9 as Int64)]
    [term >= (0 as Int64)]
    -> (Int64, Int64)
{
    let firstP: Int64 = all / (10 as Int64);
    let extra: Int64 = all % (10 as Int64);
    when extra >= (5 as Int64) {
        let r: Int64 = firstP + (1 as Int64);
        when r >= pow10(precision) {
            term (r, k + (1 as Int64));
        };
        term (r, k);
    };
    term (firstP, k);
};

// pad_digits - pad a digit string with leading zeros to length `len`.
defn pad_digits(s: String, len: Int64) [(s .^Length as Int64) >= (1 as Int64) && (s .^Length as Int64) <= len][(term .^Length as Int64) == len] -> String {
    let missing: Int64 = len - (s .^Length as Int64);
    when missing == (0 as Int64) {
        term s;
    };
    term zeros(missing) + s;
};

// strip_frac_zeros - strip trailing zeros from a fraction digit string
// (returns "" when all zeros). The integer part is untouched by %g.
defn strip_frac_zeros(frac: String) [true][(term .^Length as Int64) >= (0 as Int64)] -> String {
    when (frac .^Length as Int64) == (0 as Int64) {
        term frac;
    };
    let last: Int64 = frac[(frac .^Length as Int64) - (1 as Int64):(frac .^Length as Int64)] as Int64;
    when last == (0 as Int64) {
        term strip_frac_zeros(frac[(0 as Int64):(frac .^Length as Int64) - (1 as Int64)]);
    };
    term frac;
};

// exp_style - exponential %g form: d[.ddd]e±XX from the digit string + k.
defn exp_style(ds: String, k: Int64, sign: Int64)
    [(ds .^Length as Int64) >= (1 as Int64) && k >= -(45 as Int64) && k <= (40 as Int64) && (sign == (0 as Int64) || sign == (1 as Int64))]
    [(term .^Length as Int64) >= (2 as Int64)]
    -> String
{
    let first: String = ds[(0 as Int64):(1 as Int64)];
    let rest: String = strip_frac_zeros(ds[(1 as Int64):(ds .^Length as Int64)]);
    when (rest .^Length as Int64) == (0 as Int64) {
        term exp_style_mant(first, exp_digits(k), sign);
    };
    let mant: String = first + "." + rest;
    term exp_style_mant(mant, exp_digits(k), sign);
};

// exp_style_mant - prefix "-" when sign, then mant + "e" + exp.
defn exp_style_mant(mant: String, exp: String, sign: Int64)
    [(mant .^Length as Int64) >= (1 as Int64) && (exp .^Length as Int64) >= (2 as Int64) && (sign == (0 as Int64) || sign == (1 as Int64))][(term .^Length as Int64) >= (2 as Int64)]
    -> String
{
    when sign == (1 as Int64) {
        term "-" + mant + "e" + exp;
    };
    term mant + "e" + exp;
};

// exp_digits - "e±XX": the exponent field with sign and >= 2 digits.
defn exp_digits(k: Int64) [k >= -(45 as Int64) && k <= (40 as Int64)][(term .^Length as Int64) == (2 as Int64) || (term .^Length as Int64) == (3 as Int64)] -> String {
    when k < (0 as Int64) {
        let a: Int64 = (0 as Int64) - k;
        when a < (10 as Int64) {
            term "-0" + digit_char(a);
        };
        term "-" + digits_of_int(a);
    };
    when k < (10 as Int64) {
        term "+0" + digit_char(k);
    };
    term "+" + digits_of_int(k);
};

// fixed_style - fixed %g form: place the decimal point at position k+1.
defn fixed_style(ds: String, k: Int64, sign: Int64)
    [(ds .^Length as Int64) >= (1 as Int64) && k >= -(45 as Int64) && k <= (40 as Int64) && (sign == (0 as Int64) || sign == (1 as Int64))]
    [(term .^Length as Int64) >= (1 as Int64)]
    -> String
{
    let body: String = fixed_body(ds, k);
    when sign == (1 as Int64) && body != "0" {
        term "-" + body;
    };
    term body;
};

// fixed_body - the unsigned fixed-form body.
defn fixed_body(ds: String, k: Int64) [(ds .^Length as Int64) >= (1 as Int64) && k >= -(45 as Int64) && k <= (40 as Int64)][(term .^Length as Int64) >= (1 as Int64)] -> String {
    let n: Int64 = (ds .^Length as Int64);
    when k < (0 as Int64) {
        let z: Int64 = (0 as Int64) - k - (1 as Int64);
        let fp: String = strip_frac_zeros(ds);
        term "0." + zeros(z) + fp;
    };
    when k >= n {
        term ds + zeros(k + (1 as Int64) - n);
    };
    let ip: String = ds[(0 as Int64):k + (1 as Int64)];
    let fp: String = strip_frac_zeros(ds[k + (1 as Int64):n]);
    when (fp .^Length as Int64) == (0 as Int64) {
        term ip;
    };
    term ip + "." + fp;
};

// float_format - the full %g formatter (C printf semantics, precision sig
// digits). Sign preserved for zero ("-0"); nan/inf handled here.
defn float_format(f: Float, precision: Int64)
    [precision >= (1 as Int64) && precision <= (9 as Int64)][(term .^Length as Int64) >= (1 as Int64)]
    -> String
{
    let bits: Int64 = float_bits(f);
    let sign: Int64 = (bits >> (31 as Int64)) & (1 as Int64);
    let exp8: Int64 = (bits >> (23 as Int64)) & (0xFF as Int64);
    let mant: Int64 = bits & (0x7FFFFF as Int64);
    when exp8 == (0xFF as Int64) {
        when mant == (0 as Int64) {
            when sign == (1 as Int64) {
                term "-inf";
            };
            term "inf";
        };
        term "nan";
    };
    when exp8 == (0 as Int64) && mant == (0 as Int64) {
        when sign == (1 as Int64) {
            term "-0";
        };
        term "0";
    };
    let m: Int64 = mantissa_val(exp8, mant);
    let e: Int64 = exponent_val(exp8);
    let (r, k): (Int64, Int64) = float_rounded(m, e, precision);
    let d: Int64 = int_digit_count(r);
    let ds: String = pad_digits(digits_of_int(r), d);
    // k >= precision (P sig digits: exponent form) or k < -4 → exponential.
    when k >= precision || k < -(4 as Int64) {
        term exp_style(ds, k, sign);
    };
    term fixed_style(ds, k, sign);
};

// mantissa_val - the 24-bit significand (hidden bit for normal values).
defn mantissa_val(exp8: Int64, mant: Int64) [exp8 >= (0 as Int64) && exp8 <= (255 as Int64) && mant >= (0 as Int64)][term >= (1 as Int64)] -> Int64 {
    when exp8 == (0 as Int64) {
        term mant;
    };
    term mant + (0x800000 as Int64);
};

// exponent_val - E such that value = M x 2^E (denormal E = -149).
defn exponent_val(exp8: Int64) [exp8 >= (0 as Int64) && exp8 <= (255 as Int64)][term >= -(149 as Int64) && term <= (104 as Int64)] -> Int64 {
    when exp8 == (0 as Int64) {
        term (1 as Int64) - (150 as Int64);
    };
    term exp8 - (150 as Int64);
};
