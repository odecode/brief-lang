// bytes - a growable raw byte buffer for wire protocols (net stack L1).
//
// 2026-10-09 (fullstack-webapp net stack): PostgreSQL and HTTP need exact
// byte-level framing - lengths in network byte order, NUL-terminated strings,
// arbitrary bytes (0x00, high bytes) that a UTF-8 String cannot hold. This is
// that layer: raw memory via Malloc#/Load#/Store#, addressed as an Int.
//
// Design: a classic len/cap dynamic buffer.
//   ptr - address of the allocation, held as an Int (Malloc# returns a pointer;
//         we keep it as an integer address and do pointer arithmetic with +).
//   len - bytes written so far (the logical size).
//   cap - bytes allocated (the physical size); we grow when len would exceed it.

obj ByteBuf {
    ptr: Int;
    len: Int;
    cap: Int;
};

// buf_new - allocate a buffer with room for cap bytes (cap >= 1).
// The buffer starts empty (len 0). Malloc# gives us cap raw bytes; we hold the
// returned pointer as an Int address.
defn buf_new(cap: Int) [cap >= 1][term.cap >= cap && term.len == 0] -> ByteBuf {
    let addr: Int = Malloc#(cap) as Int;
    term ByteBuf { ptr: addr, len: 0, cap: cap };
};

// buf_free - release the allocation. After this the ByteBuf must not be used.
defn buf_free(buf: ByteBuf) -> Void {
    Free#(buf.ptr as Ptr);
    term;
};

// put_u8 - write one byte (value 0..255) at the current end, return the buffer
// with len advanced by one. Requires room (len < cap); growth is a later step.
// defn is pure, so we return a NEW ByteBuf - but Store# mutates the shared heap
// allocation in place, so ptr/cap carry over unchanged and only len moves.
defn put_u8(buf: ByteBuf, val: Int)
    [val >= 0 && val <= 255 && buf.len < buf.cap]
    [term.len == buf.len + 1 && term.cap == buf.cap]
    -> ByteBuf
{
    Store#(buf.ptr + buf.len, val, 1);
    term ByteBuf { ptr: buf.ptr, len: buf.len + 1, cap: buf.cap };
};

// get_u8 - read the byte at offset off (0..len-1). Reading at or past len would
// return uninitialized memory, so the precondition forbids it. The result is a
// single byte, hence 0..255.
defn get_u8(buf: ByteBuf, off: Int)
    [off >= 0 && off < buf.len]
    [term >= 0 && term <= 255]
    -> Int
{
    term Load#(buf.ptr + off, 1);
};

// put_u16_be - write a 16-bit value (0..65535) in BIG-ENDIAN order: the high
// byte first, then the low byte. This is network byte order - what the Postgres
// wire protocol and HTTP use for multi-byte lengths. We extract each byte with
// a shift+mask and reuse put_u8, so the two writes inherit its room contract.
// Needs room for two bytes: len + 2 <= cap.
defn put_u16_be(buf: ByteBuf, val: Int)
    [val >= 0 && val <= 65535 && buf.len + 2 <= buf.cap]
    [term.len == buf.len + 2 && term.cap == buf.cap]
    -> ByteBuf
{
    let high: ByteBuf = put_u8(buf, (val >> 8) & 255);
    term put_u8(high, val & 255);
};

// get_u16_be - read a 16-bit big-endian value at offset off: high byte at off,
// low byte at off+1, recombined as (high << 8) | low. Needs both bytes written.
defn get_u16_be(buf: ByteBuf, off: Int)
    [off >= 0 && off + 2 <= buf.len]
    [term >= 0 && term <= 65535]
    -> Int
{
    let high: Int = get_u8(buf, off);
    let low: Int = get_u8(buf, off + 1);
    term (high << 8) | low;
};

// put_u32_be - write a 32-bit value (0..4294967295) in big-endian order: four
// bytes, most significant first. This is the Postgres message length prefix.
// Needs room for four bytes: len + 4 <= cap. Built by chaining put_u8.
defn put_u32_be(buf: ByteBuf, val: Int)
    [val >= 0 && val <= 4294967295 && buf.len + 4 <= buf.cap]
    [term.len == buf.len + 4 && term.cap == buf.cap]
    -> ByteBuf
{
    let byte0: ByteBuf = put_u8(buf,   (val >> 24) & 255);
    let byte1: ByteBuf = put_u8(byte0, (val >> 16) & 255);
    let byte2: ByteBuf = put_u8(byte1, (val >> 8) & 255);
    term put_u8(byte2, val & 255);
};

// get_u32_be - read a 32-bit big-endian value at offset off: four bytes most
// significant first, recombined. Needs all four bytes written.
defn get_u32_be(buf: ByteBuf, off: Int)
    [off >= 0 && off + 4 <= buf.len]
    [term >= 0 && term <= 4294967295]
    -> Int
{
    let byte0: Int = get_u8(buf, off);
    let byte1: Int = get_u8(buf, off + 1);
    let byte2: Int = get_u8(buf, off + 2);
    let byte3: Int = get_u8(buf, off + 3);
    term (byte0 << 24) | (byte1 << 16) | (byte2 << 8) | byte3;
};

// put_bytes - copy count bytes from a source address into the buffer at the
// current end. The low-level bulk-copy primitive (Copy# lowers to llvm.memcpy).
// Needs room: len + count <= cap. count == 0 is allowed (a no-op copy).
defn put_bytes(buf: ByteBuf, src_addr: Int, count: Int)
    [count >= 0 && buf.len + count <= buf.cap]
    [term.len == buf.len + count && term.cap == buf.cap]
    -> ByteBuf
{
    Copy#(buf.ptr + buf.len, src_addr, count);
    term ByteBuf { ptr: buf.ptr, len: buf.len + count, cap: buf.cap };
};

// put_cstr - write a String as a NUL-terminated C string: the raw UTF-8 bytes
// followed by a single 0x00. This is how Postgres frames user/database/query
// strings. A Briev String is a [len][bytes][NUL] value; .^Length is its byte
// count and (text as Data) as Int is the address of its [len] header - but the
// BYTES start 8 after that header, so the copy source is that address + 8.
// Needs room for the bytes plus the terminator: len + text.^Length + 1 <= cap.
defn put_cstr(buf: ByteBuf, text: String)
    [buf.len + (text .^Length) + 1 <= buf.cap]
    [term.cap == buf.cap]
    -> ByteBuf
{
    let count: Int = text .^Length;
    let data_addr: Int = ((text as Data) as Int) + 8;
    let copied: ByteBuf = put_bytes(buf, data_addr, count);
    term put_u8(copied, 0);
};
