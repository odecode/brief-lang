import "./server_live.bv";

defn server_http(state: ServerState, slot: Int) -> ServerState {
    let input: ByteBuf = io_buffer(state.reactor,slot);
    let size: Int = io_http_size(input);
    when size == -2 { io_http_reply(state.reactor,slot,400,"{\"error\":\"invalid-request\"}"); term state; };
    when size == -3 || (size == -1 && input.len == SERVER_INPUT_LIMIT) {
        io_http_reply(state.reactor,slot,413,"{\"error\":\"request-too-large\"}"); term state;
    };
    when size < 0 || size > input.len { term state; };
    let parsed: HttpParse = http_parse_request(input,input.len);
    when parsed.status != HTTP_COMPLETE { term state; };
    io_consume(state.reactor,slot,parsed.consumed);
    let request: HttpRequest = parsed.request;
    when api_path(request.path) == "/live" {
        let upgraded: ServerState = live_upgrade(state,slot,request);
        when Load#(reactor_row(state.reactor,slot)+16,8) == 1 { term live_frames(upgraded,slot,16); };
        term upgraded;
    };
    when request.method == "GET" && (api_path(request.path) == "/state" || api_path(request.path) == "/recommendations") {
        let reply: ApiReply = server_cached_state(state,request);
        io_http_reply(state.reactor,slot,reply.status,reply.body); term state;
    };
    let reply: ApiReply = api_dispatch(state.conn,state.sessions,state.model,request,state.lambda,server_timestamp());
    let updated: ServerState = server_after_reply(state,reply);
    io_http_reply(state.reactor,slot,reply.status,reply.body);
    term updated;
};

defn server_advance(state: ServerState, slot: Int) -> ServerState {
    let row: Int = reactor_row(state.reactor,slot);
    when Load#(row,8) < 0 { term state; };
    let events: Int = reactor_events(state.reactor,slot);
    when (events & 40) != 0 { reactor_remove(state.reactor,slot); term state; };
    when (events & 17) != 0 && Load#(row+112,8) == 0 && Load#(row+120,8) == 0 {
        let count: Int = io_read(state.reactor,slot);
        when count < 0 && count != -90 { term state; };
    };
    let updated: ServerState = state;
    when Load#(row+32,8) > 0 && Load#(row+112,8) == 0 {
        when Load#(row+16,8) == 0 { updated = server_http(updated,slot); };
        when Load#(row+16,8) == 1 { updated = live_frames(updated,slot,16); };
    };
    when Load#(row,8) < 0 { term updated; };
    when Load#(row+120,8) != 0 && Load#(row+48,8) == 0 { reactor_remove(state.reactor,slot); term updated; };
    // A newly queued response may be sent immediately. One syscall per slot
    // preserves fairness; subsequent partial writes resume from saved progress.
    io_flush(state.reactor,slot);
    term updated;
};

defn server_step(state: ServerState, timeout: Int) -> ServerState {
    let updated: ServerState = state;
    when state.worker.pid > 0 || state.refresh || server_clock() >= state.next_refresh { updated = server_refresh(state); };
    let ready: Int = reactor_poll(updated.reactor,timeout);
    when ready < 0 {
        println!("Socket readiness failed (errno {}); check descriptor limits and restart with a valid MAX_CONNECTIONS.",ready);
        stdout_flush();
        let exited: Int = syscall(60,1);
        term updated;
    };
    foreach slot in 0..updated.reactor.capacity { updated = server_advance(updated,slot); };
    updated = server_refresh_owner(updated);
    term updated;
};
