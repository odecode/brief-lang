import "std/json.bv";
import "std/web/fetch.bv";
import "std/web/websocket.bv";
import "std/web/events.bv";
import "std/web/random.bv";
import { protocol_decode_event, protocol_counter_at_least } from "./protocol_events.bv";
import { protocol_profile, protocol_ratings, RECOMMENDER_PROTOCOL, protocol_encode_command }
    from "./protocol_codec.bv";
import { protocol_operation_id, protocol_version_valid, protocol_boolean, protocol_member,
    protocol_text, protocol_integer, protocol_array } from "./protocol_values.bv";
import { ProfileVersion, ProfileRating, RatingEvent, RatingCommand, RatingAccepted,
    RatingSaveFailed } from "./protocol_types.bv";
import { BrowserOperation, browser_operation_index, browser_operation_upsert,
    browser_operation_advance, browser_operation_unresolved, browser_profile_upsert, browser_profile_render,
    browser_profile_overlay } from "./browser_profile.bv";
defn client_response(text: String) -> Result<JsonValue,String> {
    when text .^Length == 0 { term Err("Cannot reach the service. Check the address and try again."); };
    let parsed: Result<JsonValue,String> = json_parse(text);
    when is_err(parsed) { term Err("The service returned an invalid JSON response."); };
    let value: JsonValue = unwrap(parsed);
    let error: String = protocol_text(protocol_member(value,"error"));
    when error .^Length > 0 {
        let message: String = protocol_text(protocol_member(value,"message"));
        when message .^Length == 0 { message = "Request failed: "+error+". Try again."; };
        term Err(message);
    };
    term Ok(value);
};

defn client_credentials(user: String, secret: String) -> String {
    let pairs: List<(String,JsonValue)> = [("username",StrVal(user)),("password",StrVal(secret))];
    term unwrap(json_stringify(Object(pairs)));
};

let api: String = query_parameter("api","http://127.0.0.1:8080");
let username: String = "";
let password: String = "";
let token: String = "";
let authenticated: Bool = false;
let notice: String = "Create an account or sign in to start rating.";

let movie: Int = 1;
let stars: Int = 5;
let rating_count: Int = 0;
let cold_start: Bool = true;
let movies_text: String = "";
let ratings_text: String = "";
let rec_lines: List<String> = [];
let channel: Int = 0;
let reconnect_timer: Int = 0;
let reconnect_delay: Int = 250;
let connection: String = "Offline";
let server_epoch: String = "";
let account_id_text: String = "";
let profile_revision: String = "0";
let model_generation: String = "0";
let server_ratings: List<ProfileRating> = [];
let browser_operations: List<BrowserOperation> = [];
let fallback_queue: List<String> = [];
let fallback_handle: Int64 = 0 as Int64;
let fallback_operation_id: String = "";
let http_requests: List<(Int,String,Int,String)> = [];
let session_generation: Int = 1;
let local_operation_counter: Int = 0;
let latest_operation_id: String = "";
let failed_operation_id: String = "";
let uncertain_operation_id: String = "";
let logout_confirmation: Bool = false;
let calculating: Bool = false;
let save_status: String = "";
let last_rendered_revision: String = "";
let has_failed_operation: Bool = false;
let has_uncertain_operation: Bool = false;

obj BrowserProfile { server_epoch: String; account_id: Int; revision: String; };

defn client_refresh_rating_view() -> Void {
    let visible: List<ProfileRating> = browser_profile_overlay(server_ratings,browser_operations);
    rating_count = visible .^Length;
    ratings_text = browser_profile_render(server_ratings,browser_operations);
    web_set_unload_warning(browser_operation_unresolved(browser_operations) > 0);
};

defn client_string_list_has(values: List<String>, wanted: String) -> Bool {
    foreach idx in 0..values .^Length { when values[idx] == wanted { term true; }; };
    term false;
};

defn client_operation_terminal(index: Int) -> Bool {
    when index < 0 { term false; };
    term browser_operations[index].status == "saved" || browser_operations[index].status == "discarded";
};

defn client_refresh_status_flags() -> Void {
    has_failed_operation = failed_operation_id .^Length > 0;
    has_uncertain_operation = uncertain_operation_id .^Length > 0;
};

defn client_operation_update(operation_id: String, status: String, revision: String,
    retryable: Bool, message: String) -> Void {
    let index: Int = browser_operation_index(browser_operations,operation_id);
    when index >= 0 {
        let old: BrowserOperation = browser_operations[index];
        let next_revision: String = revision;
        when next_revision .^Length == 0 || next_revision == "0" { next_revision = old.revision; };
        browser_operations = browser_operation_advance(browser_operations,BrowserOperation {
            operation_id: old.operation_id, item_id: old.item_id, rating: old.rating,
            revision: next_revision, status: status, retryable: retryable, message: message });
    };
    when index < 0 { save_status = "The save response did not match a request in this session."; };
    let merged_index: Int = browser_operation_index(browser_operations,operation_id);
    when merged_index >= 0 {
        let merged_status: String = browser_operations[merged_index].status;
        when merged_status == "failed" || merged_status == "unsent" { failed_operation_id = operation_id; };
        when merged_status == "uncertain" || merged_status == "unknown" { uncertain_operation_id = operation_id; };
        when merged_status == "retrying" || merged_status == "discarding" || merged_status == "accepted" || merged_status == "saved" || merged_status == "discarded" {
            when failed_operation_id == operation_id { failed_operation_id = ""; };
            when uncertain_operation_id == operation_id && (merged_status == "accepted" || merged_status == "saved" || merged_status == "discarded") { uncertain_operation_id = ""; };
        };
    };
    client_refresh_status_flags();
    client_refresh_rating_view();
};

defn client_start_http(kind: String, method: String, path: String, body: String,
    operation_id: String) -> Int {
    let options: String = "{}";
    when method != "GET" { options = "{\"content_type\":\"application/json\"}"; };
    let handle: Int = http_async_start(api+path,method,body,options,"recommender_http");
    when handle > 0 { http_requests <- (handle,kind,session_generation,operation_id); };
    term handle;
};

defn client_start_hydration() -> Bool {
    let handle: Int = client_start_http("state","GET","/v1/state?token="+token,"","");
    when handle <= 0 { notice = "Could not start profile refresh. Try reconnecting."; term false; };
    term true;
};

defn client_start_reconciliation() -> Bool {
    let ids: List<JsonValue> = [];
    let omitted: Int = 0;
    foreach idx in 0..browser_operations .^Length {
        let operation: BrowserOperation = browser_operations[idx];
        when operation.status != "saved" && operation.status != "discarded" {
            when ids .^Length < 64 { ids <- StrVal(operation.operation_id); };
            when ids .^Length >= 64 { omitted = omitted+1; };
        };
    };
    when omitted > 0 { notice = "Checking 64 unresolved saves. Resolve these before checking the rest."; };
    when ids .^Length == 0 { term true; };
    let fields: List<(String,JsonValue)> = [
        ("v",IntVal(RECOMMENDER_PROTOCOL)),("operation_ids",Array(ids))];
    let encoded: Result<String,String> = json_stringify(Object(fields));
    when is_err(encoded) { notice = "Could not prepare save-status check."; term false; };
    let handle: Int = client_start_http("status","POST","/v1/operations/status?token="+token,unwrap(encoded),"");
    when handle <= 0 { notice = "Could not start save-status check. Try again."; term false; };
    term true;
};

defn client_connect() -> Bool {
    when channel > 0 { ws_close(channel); channel = 0; };
    let address: String = "";
    when api[0:7] == "http://" { address = "ws://"+api[7:api .^Length]; };
    when api[0:8] == "https://" { address = "wss://"+api[8:api .^Length]; };
    when address .^Length == 0 { connection = "Invalid service address"; term false; };
    channel = websocket_connect(address+"/v1/live?token="+token,"recommender-live");
    connection = "Connecting";
    when channel == 0 {
        connection = "Reconnecting";
        when reconnect_timer == 0 { reconnect_timer = event_after("recommender-reconnect",reconnect_delay); };
    };
    term channel > 0;
};

defn client_protocol_owner(profile: ProfileVersion) -> Bool {
    term profile.server_epoch == server_epoch && (profile.account_id as String) == account_id_text &&
        protocol_version_valid(profile);
};

defn client_apply_accepted(accepted: RatingAccepted) -> Void {
    when client_protocol_owner(accepted.profile) {
        let index: Int = browser_operation_index(browser_operations,accepted.operation_id);
        let same_payload: Bool = true;
        when index >= 0 {
            same_payload = browser_operations[index].item_id == accepted.delta.item_id &&
                browser_operations[index].rating == accepted.delta.rating;
        };
        when !same_payload { notice = "The server reused an operation ID for a different rating. Check account status."; };
        when same_payload && (index < 0 || !client_operation_terminal(index)) {
            let update: BrowserOperation = BrowserOperation { operation_id: accepted.operation_id,
                item_id: accepted.delta.item_id, rating: accepted.delta.rating,
                revision: accepted.profile.revision, status: "accepted", retryable: false, message: "" };
            browser_operations = browser_operation_advance(browser_operations,update);
            when protocol_counter_at_least(accepted.profile.revision,profile_revision) {
                when accepted.profile.revision != profile_revision { calculating = true; };
                profile_revision = accepted.profile.revision;
                server_ratings = browser_profile_upsert(server_ratings,accepted.delta);
            };
            when failed_operation_id == accepted.operation_id { failed_operation_id = ""; };
            fallback_queue = client_remove_operation(fallback_queue,accepted.operation_id);
            client_refresh_rating_view();
            save_status = "Rating accepted; waiting for the save confirmation.";
            client_send_next_fallback();
        };
    };
};

defn client_apply_failed(failure: RatingSaveFailed) -> Void {
    let index: Int = browser_operation_index(browser_operations,failure.operation_id);
    when client_protocol_owner(failure.profile) && (index < 0 || !client_operation_terminal(index)) {
        let status: String = "failed";
        when failure.error == "commit-uncertain" { status = "uncertain"; };
        client_operation_update(failure.operation_id,status,failure.profile.revision,
            failure.retryable,failure.message);
        save_status = failure.message;
    };
};

defn client_apply_event(event: RatingEvent) -> Void {
    match event {
        AcceptedRating(accepted) => client_apply_accepted(accepted),
        SavedRating(saved) => {
            when client_protocol_owner(saved.profile) {
                client_operation_update(saved.operation_id,"saved",saved.profile.revision,false,"");
                save_status = "Rating saved.";
            };
        },
        FailedRating(failure) => client_apply_failed(failure),
        PredictedRatings(result) => {
            when client_protocol_owner(result.tag.profile) && result.tag.profile.revision == profile_revision &&
                result.tag.profile.revision != last_rendered_revision {
                cold_start = result.cold_start;
                let next_lines: List<String> = [];
                foreach idx in 0..result.items .^Length {
                    next_lines <- "Movie "+((result.items[idx].item_id+1) as String);
                };
                rec_lines = next_lines;
                model_generation = result.tag.model_generation;
                last_rendered_revision = result.tag.profile.revision;
                calculating = false;
            };
        },
        DiscardedRating(discarded) => {
            when client_protocol_owner(discarded.original.profile) &&
                protocol_counter_at_least(discarded.profile_revision,profile_revision) {
                profile_revision = discarded.profile_revision;
                server_ratings = discarded.ratings;
                client_operation_update(discarded.original.operation_id,"discarded",
                    discarded.profile_revision,false,"");
                save_status = "The failed save was discarded.";
                calculating = true;
            };
        },
    };
};

defn client_receive_event(text: String) -> Bool {
    let decoded: Result<RatingEvent,String> = protocol_decode_event(text);
    when is_err(decoded) { notice = unwrap_err(decoded); term false; };
    client_apply_event(unwrap(decoded));
    term true;
};

defn client_handle_state(value: JsonValue) -> Bool {
    when protocol_integer(protocol_member(value,"v")) != RECOMMENDER_PROTOCOL ||
        protocol_text(protocol_member(value,"type")) != "state" {
        notice = "The service returned an unsupported profile response.";
        term false;
    };
    let profile_result: Result<ProfileVersion,String> = protocol_profile(protocol_member(value,"profile"));
    when is_err(profile_result) { notice = unwrap_err(profile_result); term false; };
    let profile: ProfileVersion = unwrap(profile_result);
    when profile.server_epoch != server_epoch || (profile.account_id as String) != account_id_text {
        notice = "Your session changed. Sign in again before applying this profile.";
        term false;
    };
    when protocol_counter_at_least(profile.revision,profile_revision) {
        let decoded_ratings: Result<List<ProfileRating>,String> = protocol_ratings(protocol_member(value,"ratings"));
        when is_err(decoded_ratings) { notice = unwrap_err(decoded_ratings); term false; };
        profile_revision = profile.revision;
        server_ratings = unwrap(decoded_ratings);
        model_generation = protocol_text(protocol_member(value,"model_generation"));
        rating_count = server_ratings .^Length;
        let name: String = protocol_text(protocol_member(value,"username"));
        when name .^Length > 0 { username = name; };
        client_refresh_rating_view();
    };
    let entries: List<JsonValue> = protocol_array(protocol_member(value,"operations"));
    foreach idx in 0..entries .^Length { client_merge_operation(entries[idx]); };
    client_refresh_rating_view();
    client_start_reconciliation();
    term true;
};

defn client_merge_operation(value: JsonValue) -> Void {
    let operation_id: String = protocol_text(protocol_member(value,"operation_id"));
    let index: Int = browser_operation_index(browser_operations,operation_id);
    let old_item: Int = -1;
    let old_rating: Int = 0;
    let old_revision: String = "0";
    when index >= 0 {
        old_item = browser_operations[index].item_id;
        old_rating = browser_operations[index].rating;
        old_revision = browser_operations[index].revision;
    };
    let status: String = protocol_text(protocol_member(value,"status"));
    let item_id: Int = protocol_integer(protocol_member(value,"item_id"));
    let rating: Int = protocol_integer(protocol_member(value,"rating"));
    let revision: String = protocol_text(protocol_member(value,"revision"));
    when item_id < 0 { item_id = old_item; };
    when rating < 1 || rating > 5 { rating = old_rating; };
    when revision .^Length == 0 { revision = old_revision; };
    when operation_id .^Length == 64 && item_id >= 0 && item_id < 1682 && rating >= 1 && rating <= 5 {
        let client_status: String = "accepted";
        when status == "saved" { client_status = "saved"; };
        when status == "discarded" { client_status = "discarded"; };
        when status == "failed" || status == "discard-failed" { client_status = "failed"; };
        when status == "uncertain" || status == "discard-uncertain" { client_status = "uncertain"; };
        when status == "unknown" { client_status = "unknown"; };
        let retryable: Bool = protocol_boolean(protocol_member(value,"retryable"));
        let message: String = protocol_text(protocol_member(value,"message"));
        when client_status == "unknown" && message .^Length == 0 {
            message = "This save is unknown after a server restart. Review current ratings before deliberately resubmitting with a new ID.";
        };
        browser_operations = browser_operation_advance(browser_operations,BrowserOperation {
            operation_id: operation_id, item_id: item_id, rating: rating, revision: revision,
            status: client_status, retryable: retryable, message: message });
        let current_index: Int = browser_operation_index(browser_operations,operation_id);
        let current_status: String = browser_operations[current_index].status;
        when current_status == "failed" || current_status == "unsent" { failed_operation_id = operation_id; };
        when current_status == "uncertain" || current_status == "unknown" { uncertain_operation_id = operation_id; };
        when current_status == "accepted" || current_status == "saved" || current_status == "discarded" {
            when failed_operation_id == operation_id { failed_operation_id = ""; };
            when uncertain_operation_id == operation_id { uncertain_operation_id = ""; };
        };
        client_refresh_status_flags();
    };
};

defn client_handle_status(value: JsonValue) -> Bool {
    when protocol_integer(protocol_member(value,"v")) != RECOMMENDER_PROTOCOL ||
        protocol_text(protocol_member(value,"type")) != "operation-status" {
        notice = "The service returned an unsupported save-status response.";
        term false;
    };
    let current_epoch: String = protocol_text(protocol_member(value,"current_server_epoch"));
    let entries: List<JsonValue> = protocol_array(protocol_member(value,"operations"));
    when current_epoch != server_epoch {
        foreach idx in 0..browser_operations .^Length {
            let operation: BrowserOperation = browser_operations[idx];
            when operation.status != "saved" && operation.status != "discarded" {
                client_operation_update(operation.operation_id,"unknown",operation.revision,false,
                    "The server restarted. This operation was not replayed; check current ratings before resubmitting with a new ID.");
            };
        };
        notice = "The server epoch changed. Unknown saves were not replayed.";
        term false;
    };
    foreach idx in 0..entries .^Length { client_merge_operation(entries[idx]); };
    when uncertain_operation_id .^Length > 0 {
        let index: Int = browser_operation_index(browser_operations,uncertain_operation_id);
        when index >= 0 && browser_operations[index].status != "uncertain" &&
            browser_operations[index].status != "unknown" { uncertain_operation_id = ""; };
    };
    client_refresh_rating_view();
    term true;
};

defn client_handle_login(value: JsonValue) -> Bool {
    when protocol_integer(protocol_member(value,"v")) != RECOMMENDER_PROTOCOL ||
        protocol_text(protocol_member(value,"type")) != "authenticated" {
        notice = "The service returned an unsupported sign-in response.";
        term false;
    };
    let received_token: String = protocol_text(protocol_member(value,"token"));
    let received_epoch: String = protocol_text(protocol_member(value,"server_epoch"));
    let received_account: Int = protocol_integer(protocol_member(value,"account_id"));
    when received_token .^Length != 32 || received_account <= 0 || received_account > 2147483647 {
        notice = "The service did not return a valid session. Try signing in again.";
        term false;
    };
    when !protocol_version_valid(ProfileVersion { server_epoch: received_epoch,
        account_id: received_account, revision: "0" }) {
        notice = "The service returned an invalid server epoch. Try signing in again.";
        term false;
    };
    token = received_token;
    server_epoch = received_epoch;
    account_id_text = received_account as String;
    profile_revision = "0";
    model_generation = "0";
    server_ratings = [];
    browser_operations = [];
    web_set_unload_warning(false);
    fallback_queue = [];
    failed_operation_id = "";
    uncertain_operation_id = "";
    client_refresh_status_flags();
    last_rendered_revision = "";
    authenticated = true;
    logout_confirmation = false;
    username = protocol_text(protocol_member(value,"username"));
    notice = "Signed in. Loading your saved profile…";
    client_start_http("catalogue","GET","/movies","","");
    client_start_hydration();
    client_connect();
    term true;
};

defn client_handle_register(value: JsonValue) -> Bool {
    when protocol_integer(protocol_member(value,"v")) != RECOMMENDER_PROTOCOL ||
        protocol_text(protocol_member(value,"type")) != "registered" {
        notice = "The service returned an unsupported registration response.";
        term false;
    };
    notice = "Account created. Sign in with these credentials.";
    term true;
};

defn client_handle_catalogue(value: JsonValue) -> Void {
    let items: List<JsonValue> = protocol_array(protocol_member(value,"movies"));
    let rendered: String = "";
    foreach idx in 0..items .^Length {
        let item: Int = protocol_integer(protocol_member(items[idx],"item_id"));
        when item >= 0 && item < 1682 { rendered += ((item+1) as String)+" "; };
    };
    movies_text = rendered;
};

defn client_http_failed(kind: String, operation_id: String, http_status: Int, error: String) -> Void {
    when kind == "submit" {
        when http_status == 400 || http_status == 401 || http_status == 426 || http_status == 429 {
            client_operation_update(operation_id,"unsent","0",http_status == 429,error);
            save_status = "Rating was not accepted; it remains unsent: "+error;
        };
        when http_status != 400 && http_status != 401 && http_status != 426 && http_status != 429 {
            client_operation_update(operation_id,"uncertain","0",false,
                "The response was lost. Check save status; the request will not be replayed automatically.");
            client_start_reconciliation();
        };
    };
    when kind == "login" { notice = error; };
    when kind == "register" { notice = error; };
    when kind == "state" { notice = "Profile refresh failed: "+error; };
    when kind == "catalogue" { movies_text = "Catalogue unavailable"; };
    when kind == "retry" || kind == "discard" { save_status = "Save resolution failed: "+error; client_start_reconciliation(); };
    when kind == "status" { notice = "Could not check save status: "+error; };
};

defn client_http_success_body(kind: String, operation_id: String, body: String) -> Void {
    let response: Result<JsonValue,String> = client_response(body);
    when is_err(response) {
        client_http_failed(kind,operation_id,200,unwrap_err(response));
    };
    when is_ok(response) {
        let value: JsonValue = unwrap(response);
        when kind == "login" { client_handle_login(value); };
        when kind == "register" { client_handle_register(value); };
        when kind == "state" { client_handle_state(value); };
        when kind == "catalogue" { client_handle_catalogue(value); };
        when kind == "submit" {
            when !client_receive_event(body) {
                client_operation_update(operation_id,"uncertain","0",false,
                    "The server response could not be verified. Check save status before retrying.");
                client_start_reconciliation();
            };
        };
        when kind == "status" { client_handle_status(value); };
    };
};

defn client_http_succeeded(kind: String, operation_id: String, http_status: Int, body: String) -> Void {
    when kind == "retry" || kind == "discard" {
        client_start_hydration();
        client_start_reconciliation();
    };
    when kind != "logout" && kind != "retry" && kind != "discard" {
        when http_status < 200 || http_status >= 300 {
            let response: Result<JsonValue,String> = client_response(body);
            let message: String = "HTTP "+(http_status as String);
            when is_err(response) { message = unwrap_err(response); };
            client_http_failed(kind,operation_id,http_status,message);
        };
        when http_status >= 200 && http_status < 300 {
            client_http_success_body(kind,operation_id,body);
        };
    };
};

defn client_http_complete(kind: String, generation: Int, operation_id: String,
    handle: Int) -> Void {
    when generation == session_generation {
        let status: Int = http_async_status(handle);
        when status == 2 {
            client_http_succeeded(kind,operation_id,http_async_http_status(handle),http_async_body(handle));
        };
        when status == 3 {
            client_http_failed(kind,operation_id,http_async_http_status(handle),http_async_error(handle));
        };
    };
};

defn client_drain_http() -> Void {
    let pending: List<(Int,String,Int,String)> = http_requests;
    http_requests = [];
    foreach idx in 0..pending .^Length {
        let request: (Int,String,Int,String) = pending[idx];
        let status: Int = http_async_status(request.0);
        when status == 1 { http_requests <- request; };
        when status > 1 {
            client_http_complete(request.1,request.2,request.3,request.0);
            when (request.0 as Int64) == fallback_handle {
                fallback_queue = client_remove_operation(fallback_queue,fallback_operation_id);
                fallback_handle = 0 as Int64;
                fallback_operation_id = "";
            };
            http_async_release(request.0);
        };
        when status == 0 { };
    };
    client_send_next_fallback();
};

defn client_cancel_http() -> Void {
    foreach idx in 0..http_requests .^Length {
        let handle: Int = http_requests[idx].0;
        http_async_cancel(handle);
        http_async_release(handle);
    };
    http_requests = [];
    fallback_handle = 0 as Int64;
    fallback_operation_id = "";
};

defn client_start_operation_action(kind: String, operation_id: String) -> Bool {
    when operation_id .^Length != 64 { term false; };
    let index: Int = browser_operation_index(browser_operations,operation_id);
    when index < 0 { term false; };
    when kind == "retry" && browser_operations[index].status == "unsent" {
        client_operation_update(operation_id,"local",browser_operations[index].revision,true,"");
        term client_submit_operation(operation_id);
    };
    when kind == "retry" && !browser_operations[index].retryable {
        save_status = "This save cannot be retried. Discard it or reconcile its status.";
        term false;
    };
    when kind == "discard" && browser_operations[index].status != "failed" {
        save_status = "Only an accepted failed save can be discarded.";
        term false;
    };
    when kind == "retry" { client_operation_update(operation_id,"retrying","0",true,""); };
    when kind == "discard" { client_operation_update(operation_id,"discarding","0",false,""); };
    let handle: Int = client_start_http(kind,"POST","/v1/operations/"+operation_id+"/"+kind+"?token="+token,"",operation_id);
    when handle <= 0 { save_status = "Could not start the save action. Try again."; term false; };
    term true;
};

defn client_logout_now() -> Void {
    let logout_url: String = "/v1/logout?token="+token;
    client_cancel_http();
    when token .^Length > 0 { client_start_http("logout","POST",logout_url,"",""); };
    session_generation = session_generation+1;
    when channel > 0 { ws_close(channel); channel = 0; };
    when reconnect_timer > 0 { event_cancel(reconnect_timer); reconnect_timer = 0; };
    authenticated = false;
    token = "";
    account_id_text = "";
    server_epoch = "";
    profile_revision = "0";
    server_ratings = [];
    browser_operations = [];
    has_failed_operation = false;
    has_uncertain_operation = false;
    web_set_unload_warning(false);
    fallback_queue = [];
    failed_operation_id = "";
    uncertain_operation_id = "";
    rec_lines = [];
    ratings_text = "";
    rating_count = 0;
    cold_start = true;
    calculating = false;
    logout_confirmation = false;
    connection = "Offline";
    save_status = "";
    notice = "Signed out. Pending saves stayed with your account; sign in to check them.";
};

defn client_remove_operation(queue: List<String>, operation_id: String) -> List<String> {
    let remaining: List<String> = [];
    foreach idx in 0..queue .^Length { when queue[idx] != operation_id { remaining <- queue[idx]; }; };
    term remaining;
};

defn client_send_queued_live() -> Bool {
    when channel <= 0 || ws_status(channel) != 1 { term false; };
    when fallback_handle > (0 as Int64) { term true; };
    foreach idx in 0..fallback_queue .^Length {
        let operation_id: String = fallback_queue[idx];
        let operation_index: Int = browser_operation_index(browser_operations,operation_id);
        when operation_index >= 0 {
            let operation: BrowserOperation = browser_operations[operation_index];
            when operation.status == "local" || operation.status == "unsent" {
                let command: RatingCommand = RatingCommand { server_epoch: server_epoch,
                    operation_id: operation_id, item_id: operation.item_id, rating: operation.rating };
                let encoded: Result<String,String> = protocol_encode_command(command);
                when is_err(encoded) { term false; };
                when !ws_send(channel,unwrap(encoded)) { term false; };
                client_operation_update(operation_id,"sending",operation.revision,true,"");
            };
        };
    };
    term true;
};

defn client_send_next_fallback() -> Bool {
    when fallback_handle > (0 as Int64) || fallback_queue .^Length == 0 || !authenticated || uncertain_operation_id .^Length > 0 { term true; };
    when channel > 0 && ws_status(channel) == 1 { term client_send_queued_live(); };
    let operation_id: String = fallback_queue[0];
    let index: Int = browser_operation_index(browser_operations,operation_id);
    when index < 0 { fallback_queue = client_remove_operation(fallback_queue,operation_id); term client_send_next_fallback(); };
    let operation: BrowserOperation = browser_operations[index];
    let command: RatingCommand = RatingCommand { server_epoch: server_epoch,
        operation_id: operation_id, item_id: operation.item_id, rating: operation.rating };
    let encoded: Result<String,String> = protocol_encode_command(command);
    when is_err(encoded) { client_operation_update(operation_id,"failed",operation.revision,true,unwrap_err(encoded)); term false; };
    let handle: Int = client_start_http("submit","POST","/v1/ratings?token="+token,unwrap(encoded),operation_id);
    when handle <= 0 { save_status = "The service is busy; this rating remains on this page as unsent."; term false; };
    fallback_handle = handle as Int64;
    fallback_operation_id = operation_id;
    client_operation_update(operation_id,"sending",operation.revision,true,"");
    term true;
};

defn client_queue_fallback(operation_id: String) -> Void {
    when !client_string_list_has(fallback_queue,operation_id) { fallback_queue <- operation_id; };
    client_send_next_fallback();
};

defn client_submit_operation(operation_id: String) -> Bool {
    let index: Int = browser_operation_index(browser_operations,operation_id);
    when index < 0 { term false; };
    let operation: BrowserOperation = browser_operations[index];
    let command: RatingCommand = RatingCommand { server_epoch: server_epoch,
        operation_id: operation_id, item_id: operation.item_id, rating: operation.rating };
    let encoded: Result<String,String> = protocol_encode_command(command);
    when is_err(encoded) { save_status = unwrap_err(encoded); term false; };
    when channel > 0 && ws_status(channel) == 1 {
        when ws_send(channel,unwrap(encoded)) {
            client_operation_update(operation_id,"sending",operation.revision,true,"");
            term true;
        };
    };
    client_queue_fallback(operation_id);
    term true;
};

txn edit_movie(value: Int) [movie != value][movie == value] { movie = value; term; };
txn edit_stars(value: Int) [stars != value][stars == value] { stars = value; term; };

txn save_rating [authenticated][true] {
    when movie < 1 || stars < 1 || stars > 5 { notice = "Choose a movie number and a rating from 1 to 5."; };
    when movie >= 1 && stars >= 1 && stars <= 5 {
        when browser_operation_unresolved(browser_operations) >= 64 {
            save_status = "There are 64 unresolved saves. Check, retry or discard one before adding another.";
        };
        when browser_operation_unresolved(browser_operations) < 64 {
            when server_epoch .^Length != 32 {
                save_status = "Your session is not ready. Reconnect before saving.";
            };
            when server_epoch .^Length == 32 {
                let nonce: String = web_random_hex(16);
                when nonce .^Length != 32 { save_status = "Secure operation IDs are unavailable in this browser context."; };
                when nonce .^Length == 32 {
                    let operation_result: Result<String,String> = protocol_operation_id(server_epoch,nonce);
                    when is_err(operation_result) { save_status = unwrap_err(operation_result); };
                    when is_ok(operation_result) {
                        let operation_id: String = unwrap(operation_result);
                        let operation: BrowserOperation = BrowserOperation { operation_id: operation_id,
                            item_id: movie-1, rating: stars, revision: "0", status: "local",
                            retryable: true, message: "" };
                        browser_operations = browser_operation_advance(browser_operations,operation);
                        latest_operation_id = operation_id;
                        local_operation_counter = local_operation_counter+1;
                        calculating = true;
                        save_status = "Rating shown on this page; waiting for server acceptance.";
                        client_refresh_rating_view();
                        client_submit_operation(operation_id);
                    };
                };
            };
        };
    };
    term;
};

txn live_event [authenticated][true] {
    when channel > 0 {
        let pending: Int = ws_pending(channel);
        foreach idx in 0..pending {
            client_receive_event(ws_receive(channel));
        };
        when ws_status(channel) == 1 { connection = "Live"; reconnect_delay = 250; };
        when ws_status(channel) == 3 {
            ws_close(channel); channel = 0; connection = "Reconnecting";
            foreach idx in 0..browser_operations .^Length {
                when browser_operations[idx].status == "sending" {
                    client_operation_update(browser_operations[idx].operation_id,"uncertain",
                        browser_operations[idx].revision,false,
                        "The live connection closed before confirmation. Check status; this save was not replayed.");
                };
            };
            when reconnect_timer == 0 {
                reconnect_timer = event_after("recommender-reconnect",reconnect_delay);
                reconnect_delay = reconnect_delay*2;
                when reconnect_delay > 8000 { reconnect_delay = 8000; };
            };
        };
    };
    term;
};

txn reconnect [authenticated][true] {
    reconnect_timer = 0;
    client_start_hydration();
    client_connect();
    term;
};

txn logout [authenticated][true] {
    let unresolved: Int = browser_operation_unresolved(browser_operations);
    let already_confirmed: Bool = logout_confirmation;
    when unresolved > 0 && !already_confirmed {
        logout_confirmation = true;
        notice = "Unresolved saves remain. Sign out clears this page; only saves already accepted by the server stay with your account.";
    };
    when unresolved == 0 || already_confirmed { client_logout_now(); };
    term;
};
txn edit_username(value: String) [username != value][username == value] {
    username = value; term;
};

txn edit_password(value: String) [password != value][password == value] {
    password = value; term;
};

txn register_user [!authenticated][true] {
    session_generation = session_generation+1;
    let handle: Int = client_start_http("register","POST","/v1/register",client_credentials(username,password),"");
    when handle <= 0 { notice = "Could not start registration. Try again."; };
    when handle > 0 { notice = "Creating your account…"; };
    term;
};

txn login_user [!authenticated][true] {
    session_generation = session_generation+1;
    let handle: Int = client_start_http("login","POST","/v1/login",client_credentials(username,password),"");
    when handle <= 0 { notice = "Could not start sign-in. Try again."; };
    when handle > 0 { notice = "Signing in…"; };
    term;
};

txn http_event [http_requests .^Length <= 32][http_requests .^Length <= 32] { client_drain_http(); term; };
txn retry_failed_save [authenticated][failed_operation_id .^Length > 0] {
    client_start_operation_action("retry",failed_operation_id); term;
};
txn discard_failed_save [authenticated][failed_operation_id .^Length > 0] {
    client_start_operation_action("discard",failed_operation_id); term;
};
txn check_save_status [authenticated][uncertain_operation_id .^Length > 0] {
    client_start_reconciliation(); term;
};
txn leave_with_pending_saves [authenticated][logout_confirmation] { client_logout_now(); term; };

<view>
  <main class="shell" b-window:recommender_http="http_event">
    <header><p class="eyebrow">THE NEXT GOOD FILM</p><h1>A little taste.<br>A better shortlist.</h1><p>Rate what you know. Find something you will love.</p></header>
    <p id="notice" role="status" aria-live="polite" b-text="notice">Create an account or sign in to start rating.</p>
    <section class="panel" b-show="authenticated == false">
      <h2>Your taste starts here</h2>
      <label for="username">Username</label><input id="username" autocomplete="username" b-bind:value="username">
      <label for="password">Password</label><input id="password" type="password" autocomplete="current-password" b-bind:value="password">
      <div class="actions"><button id="login" b-trigger:click="login_user">Sign in</button><button id="register" class="secondary" b-trigger:click="register_user">Create account</button></div>
      <p class="muted">Demo accounts only. Use a password you do not use elsewhere.</p>
    </section>
    <section class="panel" b-show="authenticated" b-window:recommender-live="live_event">
      <p>Connection: <span id="connection" b-text="connection">Connecting</span></p>
      <button class="secondary" id="logout" b-trigger:click="logout">Sign out</button>
      <button class="secondary" id="logout-confirm" b-show="logout_confirmation" b-trigger:click="leave_with_pending_saves">Sign out anyway</button>
      <h2>Rate a film</h2><p>Available movie numbers: <span id="movies" b-text="movies_text"></span></p>
      <label for="movie">Movie number</label><input id="movie" type="number" min="1" b-bind:value="movie">
      <label for="stars">Rating (1 to 5)</label><input id="stars" type="number" min="1" max="5" b-bind:value="stars">
      <p><button id="save-rating" b-trigger:click="save_rating">Save rating</button></p>
      <p id="save-status" role="status" aria-live="polite" b-text="save_status"></p>
      <p id="calculating" b-show="calculating" aria-live="polite">Updating your shortlist…</p>
      <div id="save-actions" b-show="has_failed_operation">
        <button id="retry-save" class="secondary" b-trigger:click="retry_failed_save">Retry save</button>
        <button id="discard-save" class="secondary" b-trigger:click="discard_failed_save">Discard failed save</button>
      </div>
      <p><button id="check-save-status" class="secondary" b-show="has_uncertain_operation" b-trigger:click="check_save_status">Check save status</button></p>
      <p>Rated films: <span id="rating-count" b-text="rating_count">0</span></p>
      <p id="ratings" b-text="ratings_text"></p>
    </section>
    <section class="panel" b-show="authenticated" b-window:recommender-reconnect="reconnect">
      <p id="cold-start" b-show="cold_start">Rate at least five different movies to unlock your shortlist.</p>
      <div id="recommendations" b-show="cold_start == false"><h2>Your next good film</h2>
        <ol><li b-each:item="rec_lines" b-key="item"><span b-text="item"></span></li></ol>
      </div>
    </section>
    <footer>Recommendations shaped by your ratings · AutAI-Fusion</footer>
  </main>
</view>

<style>
  * { box-sizing: border-box; }
  body { margin: 0; background: #f4f1e8; color: #1c2e2a; font-family: system-ui, sans-serif; }
  .shell { max-width: 1100px; margin: 0 auto; padding: 56px 24px; }
  header { padding: 12px 0 32px; }
  .eyebrow { color: #57776a; font-size: 12px; font-weight: 700; letter-spacing: .18em; }
  h1 { font-family: Georgia, serif; font-size: clamp(42px, 7vw, 78px); line-height: 1.05; font-weight: 400; letter-spacing: -.04em; margin: 20px 0; }
  h2 { font-family: Georgia, serif; font-size: 28px; font-weight: 400; }
  #notice { padding: 16px 20px; background: #e2eadf; border-left: 3px solid #3b6551; border-radius: 4px; }
  .panel { background: #fffdf6; padding: 28px; margin-top: 24px; border: 1px solid #deded0; border-radius: 16px; }
  label { display: block; font-size: 14px; font-weight: 600; margin: 18px 0 8px; }
  input, select { font: inherit; padding: 12px; border: 1px solid #aebcae; border-radius: 8px; background: white; width: 100%; max-width: 420px; }
  button { padding: 13px 20px; font: inherit; font-weight: 600; border: 1px solid #244b3a; background: #244b3a; color: white; border-radius: 8px; cursor: pointer; }
  button:hover { background: #37664e; }
  button:focus-visible, input:focus-visible, select:focus-visible { outline: 3px solid #b38035; outline-offset: 3px; }
  button.secondary { color: #244b3a; background: transparent; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 22px 0; }
  .muted, footer { color: #65736b; font-size: 13px; line-height: 1.6; }
  footer { margin-top: 32px; }
  @media(max-width: 600px) { .shell { padding: 24px 16px; } .panel { padding: 20px; } }
</style>

when true { reside; };

