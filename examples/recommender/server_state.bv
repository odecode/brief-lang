import "./server_api.bv";
import "./server_io.bv";
import "./model_worker.bv";
import "./sessions.bv";
import { stdout_flush } from "std/cast_lanes.bv";

obj OwnerView { owner: Int; recommendations: String; };
obj ServerState {
    reactor: Reactor; conn: PgConn; model: ServerModel; sessions: SessionStore;
    server_epoch: String;
    views: List<OwnerView>; lambda: Float; refresh: Bool; next_refresh: Int; interval: Int; worker: RefreshWorker;
};

defn server_time(clock_id: Int) -> Int {
    let memory: Int = Malloc#(16) as Int;
    when memory == 0 { term -1; };
    let result: Int = syscall(228,clock_id,memory);
    // 2026-10-22: a failed clock call leaves timespec unwritten. Check before
    // reading it; retain this guard if clock allocation is later centralized.
    when result < 0 { Free#(memory as Ptr); term -1; };
    let now: Int = Load#(memory,8)*1000 + Load#(memory+8,8)/1000000;
    Free#(memory as Ptr);
    term now;
};

defn server_clock() -> Int { term server_time(1); };
defn server_timestamp_from_millis(milliseconds: Int) -> Int {
    when milliseconds < 0 { term -1; };
    term milliseconds/1000;
};

defn server_timestamp() -> Int { term server_timestamp_from_millis(server_time(0)); };

defn server_new(reactor: Reactor, conn: PgConn, model: ServerModel, lambda: Float, interval: Int) -> ServerState {
    let views: List<OwnerView> = [];
    // 2026-10-23: one random process identity scopes protocol profile revisions
    // across account sessions; preserve it across snapshots and state copies.
    // Undo by removing the field only when the server protocol owns an epoch.
    let epoch: String = session_random_token();
    term ServerState { reactor: reactor, conn: conn, model: model, sessions: sessions_new(),
        server_epoch: epoch,
        views: views, lambda: lambda, refresh: false, next_refresh: server_clock()+interval, interval: interval, worker: worker_idle() };
};

defn server_with(state: ServerState, sessions: SessionStore, views: List<OwnerView>, refresh: Bool) -> ServerState {
    term ServerState { reactor: state.reactor, conn: state.conn, model: state.model, sessions: sessions,
        server_epoch: state.server_epoch,
        views: views, lambda: state.lambda, refresh: refresh, next_refresh: state.next_refresh, interval: state.interval, worker: state.worker };
};

defn server_owner_view(views: List<OwnerView>, owner: Int) -> String {
    foreach idx in 0..views .^Length { when views[idx].owner == owner { term views[idx].recommendations; }; };
    term "";
};

defn server_set_view(views: List<OwnerView>, owner: Int, body: String) -> List<OwnerView> {
    let updated: List<OwnerView> = [];
    foreach idx in 0..views .^Length {
        when views[idx].owner != owner {
            let entry: List<OwnerView> = [views[idx]];
            updated = updated + entry;
        };
    };
    let added: List<OwnerView> = [OwnerView { owner: owner, recommendations: body }];
    term updated + added;
};

defn server_owner_token(sessions: SessionStore, owner: Int) -> String {
    foreach idx in 0..sessions.entries .^Length {
        when sessions.entries[idx].account_id == owner { term sessions.entries[idx].token; };
    };
    term "";
};

defn server_update_owner(state: ServerState, owner: Int) -> ServerState {
    let identity_started: Int = trace_clock();
    let account: AccountState = account_state(state.conn,state.sessions,server_owner_token(state.sessions,owner));
    trace_stage("prediction_identity_db",identity_started);
    let body: String = "{\"error\":\"auth-failed\"}";
    when account.result.ok { body = api_recommendations(state.model,account,state.lambda); };
    when !account.result.ok && account.result.error != "auth-failed" { body = "{\"error\":\"database\"}"; };
    term server_with(state,state.sessions,server_set_view(state.views,owner,body),state.refresh);
};

// 2026-10-21: login and rating changes materialize one owner's recommendations.
// GETs read that result, never rerun similarity construction. Refresh updates
// all materialized owners only AFTER the replacement model is complete.
// Replace this per-owner cache only with another population-independent read path.
defn server_cached_state(state: ServerState, request: HttpRequest) -> ApiReply {
    let identity_started: Int = trace_clock();
    let account: AccountState = account_state(state.conn,state.sessions,api_token(request.path));
    trace_stage("state_identity_db",identity_started);
    when !account.result.ok { term api_error(account.result.error,state.sessions); };
    let body: String = server_owner_view(state.views,account.result.account.id);
    when body .^Length == 0 { term api_error("session",state.sessions); };
    when api_path(request.path) == "/recommendations" { term api_reply(200,body,state.sessions); };
    term api_reply(200,api_protocol_state(account,state.server_epoch,state.model,body),state.sessions);
};

defn server_channel_owned(row: Int, owner: Int) -> Bool {
    term owner > 0 && Load#(row,8) >= 0 && Load#(row+16,8) == 1 && Load#(row+24,8) == owner && Load#(row+112,8) == 0;
};

defn server_push(state: ServerState, owner: Int) -> Bool {
    let push_started: Int = trace_clock();
    let body: String = server_owner_view(state.views,owner);
    foreach slot in 0..state.reactor.capacity {
        let row: Int = reactor_row(state.reactor,slot);
        when server_channel_owned(row,owner) {
            io_queue(state.reactor,slot,ws_encode_text(body));
        };
    };
    trace_stage("push_queue",push_started);
    term true;
};

defn server_refresh(state: ServerState) -> ServerState {
    when state.worker.pid > 0 { term server_finish_refresh(state); };
    when state.worker.owners .^Length > 0 { term state; };
    let worker: RefreshWorker = worker_start(state.conn,state.reactor,state.model.baseline_users,state.model.population.nitems);
    let updated: ServerState = server_snapshot_state(state,state.model,worker,false,server_clock()+state.interval);
    when worker.pid == 0 { println!("Cannot start snapshot refresh; check database access and CACHE_PATH. Serving the previous snapshot."); stdout_flush(); };
    term updated;
};

defn server_snapshot_state(state: ServerState, model: ServerModel, worker: RefreshWorker, queued: Bool, deadline: Int) -> ServerState {
    term ServerState { reactor: state.reactor, conn: state.conn, model: model, sessions: state.sessions,
        server_epoch: state.server_epoch,
        views: state.views, lambda: state.lambda, refresh: queued, next_refresh: deadline, interval: state.interval, worker: worker };
};

// 2026-10-21: only a reaped, successful worker can install its complete model.
// Newer requests/sessions survive the swap. Refresh requests during a build
// remain queued; failure retains the old model. Rebuild owner views one per
// sweep rather than holding the event loop for all logged-in owners at once.
defn server_finish_refresh(state: ServerState) -> ServerState {
    let status: Int = worker_poll(state.worker);
    when status == 0 { term state; };
    let updated: ServerState = server_snapshot_state(state,state.model,worker_idle(),state.refresh,server_clock()+state.interval);
    let loaded: Result<ServerModel,PgResult> = Err(store_error("Snapshot worker failed; retry refresh."));
    when status == 1 { loaded = model_restore(state.worker.path,"",state.model.baseline_users,state.model.population.nitems); };
    remove_file(state.worker.path);
    remove_file(state.worker.path+".tmp."+state.worker.pid as String);
    when is_err(loaded) {
        println!("Snapshot refresh failed; check database access and CACHE_PATH, then retry /admin/refresh. Serving the previous snapshot.");
        stdout_flush(); term updated;
    };
    updated.model = unwrap(loaded);
    let owners: List<Int> = [];
    foreach idx in 0..state.views .^Length { let entry: List<Int> = [state.views[idx].owner]; owners = owners+entry; };
    updated.worker = RefreshWorker { pid: 0, path: "", owners: owners };
    model_free(state.model);
    term updated;
};

defn server_refresh_owner(state: ServerState) -> ServerState {
    let pending: List<Int> = state.worker.owners;
    when pending .^Length == 0 { term state; };
    let updated: ServerState = server_update_owner(state,pending[0]);
    server_push(updated,pending[0]);
    let remaining: List<Int> = [];
    foreach idx in 1..pending .^Length { let entry: List<Int> = [pending[idx]]; remaining = remaining+entry; };
    updated.worker = RefreshWorker { pid: state.worker.pid, path: state.worker.path, owners: remaining };
    term updated;
};

defn server_after_reply(state: ServerState, reply: ApiReply) -> ServerState {
    let updated: ServerState = server_with(state,reply.sessions,state.views,state.refresh || reply.refresh);
    when reply.sessions.entries .^Length > state.sessions.entries .^Length {
        let last: Int = reply.sessions.entries .^Length - 1;
        updated = server_update_owner(updated,reply.sessions.entries[last].account_id);
    };
    when reply.changed_owner > 0 {
        updated = server_update_owner(updated,reply.changed_owner);
        server_push(updated,reply.changed_owner);
    };
    term updated;
};
